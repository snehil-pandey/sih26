# Deployment Profile (local | hosted)
DEPLOYMENT_PROFILE=local

# Cryptographic Profile (demo | production)
APP_MODE=demo

# Server HTTP Port
PORT=3000

# Optional TLS / HTTPS configuration
# TLS_CERT_PATH=/path/to/fullchain.pem
# TLS_KEY_PATH=/path/to/privkey.pem

# Optional Custom Persistence Directory (defaults to in-memory or data/)
# DATA_DIR=./data

# Seed Account Passwords (in demo mode)
SIH_DEMO_PASSWORD=demo1234

# Bootstrap Administrator (Used on initial boot when no admin accounts exist)
# SIH_BOOTSTRAP_ADMIN_USER=admin
# SIH_BOOTSTRAP_ADMIN_PASSWORD=change-this-in-production-1234
